---
import AssetRecovery from '../../components/AssetRecovery.astro';
import {
  archiveItems,
  archiveStats,
  mediaLabels,
  styleSystems,
  type ArchiveItem,
} from '../../content/archive';
import '../../styles/global.css';
import '../../styles/work-detail.css';

export function getStaticPaths() {
  return archiveItems.map((item, itemIndex) => ({
    params: { id: item.id },
    props: { item, itemIndex },
  }));
}

type Props = {
  item: ArchiveItem;
  itemIndex: number;
};

const { item, itemIndex } = Astro.props;
const firstVariant = item.variants[0];
const firstStyle = styleSystems.find((style) => style.id === firstVariant.styleId)!;
const previousItem = archiveItems[(itemIndex - 1 + archiveItems.length) % archiveItems.length];
const nextItem = archiveItems[(itemIndex + 1) % archiveItems.length];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <AssetRecovery />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${item.title}：作品背景、AI 视觉解读与海报版本。`}
    />
    <meta name="theme-color" content="#d8d2c6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{item.title}｜余像札记</title>
  </head>
  <body class="detail-page">
    <header class="detail-bar">
      <a class="detail-mark" href="/" aria-label="返回余像札记首页">
        <span>余像札记</span>
        <span>Afterimage Notes</span>
      </a>
      <p>AI CULTURAL POSTER ARCHIVE</p>
      <a
        class="detail-back"
        data-detail-back
        href={`/archive/?work=${item.id}&poster=${firstVariant.id}`}
      >
        <span aria-hidden="true">←</span><span>返回作品目录</span>
      </a>
    </header>

    <main>
      <article
        class="detail-stage"
        data-detail-stage
        style={`--accent:${firstVariant.accent}`}
        aria-labelledby="work-title"
        aria-busy="true"
        data-media-state="loading"
      >
        <p class="detail-folio">{item.archiveNo} / {String(archiveStats.items).padStart(2, '0')}</p>

        <figure class="detail-poster">
          <div class="detail-poster__sheet">
            <img
              data-detail-image
              src={firstVariant.image}
              alt={firstVariant.alt}
              width={firstVariant.width}
              height={firstVariant.height}
              decoding="async"
              fetchpriority="high"
            />
            <img data-detail-image-next alt="" aria-hidden="true" decoding="async" />
            <div class="detail-media-status" data-detail-media-status aria-live="polite">
              <span aria-hidden="true"></span>
              <b data-detail-media-status-text>正在显影</b>
              <button type="button" data-detail-retry-image hidden>重新显影</button>
            </div>
            <i aria-hidden="true"></i>
          </div>
          <figcaption>
            <span data-detail-style>{firstStyle.englishLabel}</span>
            <span data-detail-count>01 / {String(item.variants.length).padStart(2, '0')}</span>
          </figcaption>
        </figure>

        <section class="detail-copy">
          <p class="detail-copy__eyebrow">
            <span>{mediaLabels[item.type]}</span>
            <span>{item.year} · {item.context}</span>
          </p>

          <h1 id="work-title">{item.title}</h1>
          {item.originalTitle && <p class="detail-copy__original">{item.originalTitle}</p>}
          <p class="detail-copy__creator">{item.creator}</p>

          <nav class="detail-variants" aria-label="切换视觉版本">
            <p class="detail-variants__label">
              <span>切换视觉版本</span>
              <small>SELECT POSTER</small>
            </p>
            <div class="detail-variants__options">
              {item.variants.map((variant, index) => {
                const style = styleSystems.find((candidate) => candidate.id === variant.styleId)!;
                return (
                  <button
                    type="button"
                    data-variant-id={variant.id}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    <b>{String(index + 1).padStart(2, '0')}</b>
                    <span>{style.label}</span>
                    <small>{style.englishLabel}</small>
                  </button>
                );
              })}
            </div>
          </nav>

          <div class="detail-reading">
            <section class="detail-ai" aria-labelledby="ai-title">
              <header>
                <p>AI INTERPRETATION</p>
                <h2 id="ai-title">AI 解读</h2>
                <span aria-hidden="true"></span>
              </header>
              <p data-detail-interpretation>{firstVariant.interpretation}</p>
            </section>

            <div class="detail-support">
              <section class="detail-source" aria-labelledby="source-title">
                <p class="detail-source__label" id="source-title">
                  <span>作品背景</span>
                  <small>SOURCE CONTEXT</small>
                </p>
                <p>{item.background}</p>
              </section>

              <p class="detail-style-note" data-detail-style-note>{firstStyle.shortDescription}</p>
            </div>
          </div>
        </section>

        <nav class="detail-step" aria-label="相邻作品">
          <a class="detail-step__previous" data-adjacent-work href={`/works/${previousItem.id}/`}>
            <span class="detail-step__arrow" aria-hidden="true">←</span>
            <span class="detail-step__direction">上一件作品</span>
            <b>{previousItem.title}</b>
          </a>
          <a
            class="detail-step__index"
            data-detail-index
            href={`/archive/?work=${item.id}&poster=${firstVariant.id}`}
          >
            <span>返回作品目录</span>
            <b>{String(archiveStats.items).padStart(2, '0')} 件馆藏</b>
          </a>
          <a class="detail-step__next" data-adjacent-work href={`/works/${nextItem.id}/`}>
            <span class="detail-step__direction">下一件作品</span>
            <b>{nextItem.title}</b>
            <span class="detail-step__arrow" aria-hidden="true">→</span>
          </a>
        </nav>
      </article>
    </main>

    <script
      is:inline
      id="work-data"
      type="application/json"
      set:html={JSON.stringify({ item, styles: styleSystems })}
    ></script>
    <script src="../../scripts/work-detail.ts"></script>
  </body>
</html>
