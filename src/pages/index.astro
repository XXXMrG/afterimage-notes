---
import {
  archiveItems,
  archiveStats,
  mediaLabels,
  styleSystems,
} from '../content/archive';
import '../styles/global.css';

const clientArchive = archiveItems.map((item) => ({
  ...item,
  typeLabel: mediaLabels[item.type],
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="余像札记：AI 如何理解一首歌、一部电影或一本书，并把这种理解转译成不同视觉风格的海报。"
    />
    <meta name="theme-color" content="#d8d2c6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>余像札记｜AI 文化海报档案</title>
  </head>
  <body>
    <main class="archive-shell">
      <header class="masthead" aria-labelledby="site-title">
        <h1 id="site-title" class="masthead__title">余像札记<br />Afterimage Notes</h1>
        <p class="masthead__intro">
          同一个作品，<br />
          可以留下不止一种余像。<br />
          <span>AI 对歌曲、电影与书籍的视觉理解。</span>
        </p>
        <p class="masthead__meta">
          CULTURAL POSTER ARCHIVE<br />
          {String(archiveStats.items).padStart(2, '0')} WORKS / {String(archiveStats.posters).padStart(2, '0')} POSTERS / {String(archiveStats.styles).padStart(2, '0')} SYSTEMS
        </p>
        <a class="masthead__enter" href="#archive">进入档案 <span aria-hidden="true">↓</span></a>
      </header>

      <section id="archive" class="archive" aria-labelledby="archive-heading">
        <header class="archive__header">
          <div>
            <p class="section-kicker">Archive index</p>
            <h2 id="archive-heading">作品目录</h2>
          </div>
          <p class="archive__count" aria-live="polite">
            <span data-visible-count>{archiveStats.items}</span> / {archiveStats.items}
          </p>
        </header>

        <div class="filter-ledger" aria-label="档案筛选">
          <div class="filter-line" role="group" aria-label="按内容类型筛选">
            <span class="filter-line__label">媒介</span>
            <button type="button" data-filter-type="all" aria-pressed="true">全部</button>
            {Object.entries(mediaLabels).map(([id, label]) => (
              <button type="button" data-filter-type={id} aria-pressed="false">{label}</button>
            ))}
          </div>
          <div class="filter-line" role="group" aria-label="按视觉风格筛选">
            <span class="filter-line__label">视觉</span>
            <button type="button" data-filter-style="all" aria-pressed="true">全部</button>
            {styleSystems.map((style) => (
              <button type="button" data-filter-style={style.id} aria-pressed="false">{style.label}</button>
            ))}
          </div>
        </div>

        <div class="archive-layout">
          <nav class="work-index" aria-label="作品目录">
            <ol data-work-index>
              {archiveItems.map((item, itemIndex) => (
                <li>
                  <button
                    type="button"
                    class="index-entry"
                    data-select-work={item.id}
                    data-item-type={item.type}
                    data-item-styles={item.variants.map((variant) => variant.styleId).join(' ')}
                    aria-current={itemIndex === 0 ? 'true' : undefined}
                    style={`--entry-accent:${item.variants[0].accent}`}
                  >
                    <span class="index-entry__no">{item.archiveNo}</span>
                    <span class="index-entry__title">{item.title}</span>
                    <span class="index-entry__meta">{mediaLabels[item.type]} · {item.year}</span>
                    <span class="index-entry__versions">{String(item.variants.length).padStart(2, '0')}</span>
                  </button>
                </li>
              ))}
            </ol>
            <p class="empty-note" data-empty hidden>这个交叉条件下，还没有海报。</p>
          </nav>

          <article class="viewer" data-viewer aria-live="polite" style={`--accent:${archiveItems[0].variants[0].accent}`}>
            <div class="viewer__frame">
              <img
                data-viewer-image
                src={archiveItems[0].variants[0].image}
                alt={archiveItems[0].variants[0].alt}
                width={archiveItems[0].variants[0].width}
                height={archiveItems[0].variants[0].height}
                decoding="async"
              />
              <span class="viewer__folio" data-viewer-folio>{archiveItems[0].archiveNo}</span>
            </div>

            <div class="viewer__notes">
              <p class="viewer__eyebrow">
                <span data-viewer-type>{mediaLabels[archiveItems[0].type]}</span>
                <span><span data-viewer-year>{archiveItems[0].year}</span> / <span data-viewer-context>{archiveItems[0].context}</span></span>
              </p>
              <h3 data-viewer-title>{archiveItems[0].title}</h3>
              <p class="viewer__original" data-viewer-original hidden></p>
              <p class="viewer__creator" data-viewer-creator>{archiveItems[0].creator}</p>

              <div class="variant-nav" data-variant-nav aria-label="海报风格版本"></div>

              <div class="viewer__reading">
                <span>AI interpretation</span>
                <p data-viewer-interpretation>{archiveItems[0].variants[0].interpretation}</p>
              </div>

              <p class="viewer__style-note" data-viewer-style-note>{styleSystems[0].shortDescription}</p>

              <a
                class="viewer__open"
                data-viewer-open
                href={`/works/${archiveItems[0].id}/?poster=${archiveItems[0].variants[0].id}`}
              >
                <span>进入完整作品</span><span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        </div>
      </section>

      <footer class="site-footer">
        <p>不是复述作品，也不是还原情节。每张海报保存的是模型在一次阅读之后，选择留下的那个视觉关系。</p>
        <p>Archive grows by work × interpretation × visual system.</p>
      </footer>
    </main>

    <script is:inline id="archive-data" type="application/json" set:html={JSON.stringify({ items: clientArchive, styles: styleSystems })}></script>
    <script is:inline>
      const payload = JSON.parse(document.getElementById('archive-data').textContent);
      const items = payload.items;
      const styles = payload.styles;
      const pageUrl = new URL(window.location.href);
      const requestedItem = items.find((item) => item.id === pageUrl.searchParams.get('work'));
      const requestedVariant = requestedItem?.variants.find((variant) => variant.id === pageUrl.searchParams.get('poster'));
      const state = {
        type: 'all',
        style: 'all',
        itemId: requestedItem?.id ?? items[0].id,
        variantId: requestedVariant?.id ?? requestedItem?.variants[0].id ?? items[0].variants[0].id,
      };

      const typeButtons = [...document.querySelectorAll('[data-filter-type]')];
      const styleButtons = [...document.querySelectorAll('[data-filter-style]')];
      const indexButtons = [...document.querySelectorAll('[data-select-work]')];
      const viewer = document.querySelector('[data-viewer]');
      const visibleCount = document.querySelector('[data-visible-count]');
      const emptyNote = document.querySelector('[data-empty]');
      const variantNav = document.querySelector('[data-variant-nav]');

      const getStyle = (styleId) => styles.find((style) => style.id === styleId);
      const syncUrl = () => {
        if (!state.itemId || !state.variantId) return;
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.set('work', state.itemId);
        nextUrl.searchParams.set('poster', state.variantId);
        history.replaceState(null, '', `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
      };
      const matches = (item) => {
        const typeMatch = state.type === 'all' || item.type === state.type;
        const styleMatch = state.style === 'all' || item.variants.some((variant) => variant.styleId === state.style);
        return typeMatch && styleMatch;
      };

      function availableVariants(item) {
        return state.style === 'all'
          ? item.variants
          : item.variants.filter((variant) => variant.styleId === state.style);
      }

      function selectFirstVisible() {
        const visibleItems = items.filter(matches);
        if (!visibleItems.some((item) => item.id === state.itemId)) {
          state.itemId = visibleItems[0]?.id ?? null;
          state.variantId = visibleItems[0] ? availableVariants(visibleItems[0])[0]?.id : null;
        }
        return visibleItems;
      }

      function renderViewer() {
        const item = items.find((candidate) => candidate.id === state.itemId);
        if (!item) {
          viewer.hidden = true;
          return;
        }

        const variants = availableVariants(item);
        let variant = variants.find((candidate) => candidate.id === state.variantId);
        if (!variant) {
          variant = variants[0];
          state.variantId = variant.id;
        }
        const style = getStyle(variant.styleId);
        viewer.hidden = false;
        viewer.style.setProperty('--accent', variant.accent);

        const image = viewer.querySelector('[data-viewer-image]');
        image.classList.add('is-changing');
        image.src = variant.image;
        image.alt = variant.alt;
        image.width = variant.width;
        image.height = variant.height;
        image.onload = () => image.classList.remove('is-changing');
        if (image.complete) image.classList.remove('is-changing');

        viewer.querySelector('[data-viewer-folio]').textContent = item.archiveNo;
        viewer.querySelector('[data-viewer-type]').textContent = item.typeLabel;
        viewer.querySelector('[data-viewer-year]').textContent = item.year;
        viewer.querySelector('[data-viewer-context]').textContent = item.context;
        viewer.querySelector('[data-viewer-title]').textContent = item.title;
        viewer.querySelector('[data-viewer-creator]').textContent = item.creator;
        viewer.querySelector('[data-viewer-interpretation]').textContent = variant.interpretation;
        viewer.querySelector('[data-viewer-style-note]').textContent = style.shortDescription;
        viewer.querySelector('[data-viewer-open]').href = `/works/${item.id}/?poster=${variant.id}`;

        const original = viewer.querySelector('[data-viewer-original]');
        original.textContent = item.originalTitle ?? '';
        original.hidden = !item.originalTitle;

        variantNav.replaceChildren();
        item.variants.forEach((candidate, index) => {
          const candidateStyle = getStyle(candidate.styleId);
          const button = document.createElement('button');
          button.type = 'button';
          button.dataset.selectVariant = candidate.id;
          button.textContent = `${String(index + 1).padStart(2, '0')} ${candidateStyle.label}`;
          button.setAttribute('aria-pressed', candidate.id === variant.id ? 'true' : 'false');
          if (state.style !== 'all' && candidate.styleId !== state.style) button.hidden = true;
          button.addEventListener('click', () => {
            state.variantId = candidate.id;
            renderViewer();
            syncUrl();
          });
          variantNav.append(button);
        });
        variantNav.hidden = variants.length <= 1;
      }

      function render() {
        const visibleItems = selectFirstVisible();
        visibleCount.textContent = String(visibleItems.length);
        emptyNote.hidden = visibleItems.length !== 0;

        indexButtons.forEach((button) => {
          const item = items.find((candidate) => candidate.id === button.dataset.selectWork);
          const visible = matches(item);
          button.closest('li').hidden = !visible;
          if (visible && item.id === state.itemId) button.setAttribute('aria-current', 'true');
          else button.removeAttribute('aria-current');
        });

        typeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filterType === state.type)));
        styleButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filterStyle === state.style)));
        renderViewer();
      }

      typeButtons.forEach((button) => button.addEventListener('click', () => {
        state.type = button.dataset.filterType;
        render();
        syncUrl();
      }));

      styleButtons.forEach((button) => button.addEventListener('click', () => {
        state.style = button.dataset.filterStyle;
        render();
        syncUrl();
      }));

      indexButtons.forEach((button) => button.addEventListener('click', () => {
        state.itemId = button.dataset.selectWork;
        const item = items.find((candidate) => candidate.id === state.itemId);
        state.variantId = availableVariants(item)[0].id;
        render();
        syncUrl();
        if (window.matchMedia('(max-width: 820px)').matches) {
          viewer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }));

      render();
    </script>
  </body>
</html>
