---
import { works } from '../content/works';
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="余像札记：四次 AI 生图记录，保存图像、提示词与模型对图像的解读。"
    />
    <meta name="theme-color" content="#d8d2c6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>余像札记｜图像、提示词与解读</title>
  </head>
  <body>
    <nav class="archive-nav" aria-label="作品索引">
      {works.map((work, index) => (
        <a
          href={`#${work.id}`}
          data-nav={work.id}
          aria-label={`前往第 ${index + 1} 件作品：${work.title}`}
          aria-current={index === 0 ? 'true' : undefined}
        >
          {work.index}
        </a>
      ))}
    </nav>

    <main class="archive-shell">
      <header class="masthead">
        <h1 class="masthead__title">余像札记<br />Afterimage Notes</h1>
        <p class="masthead__intro">
          四次听见，一次生成。<br />
          图像、提示词，<br class="mobile-break" />以及模型当时的理解。
        </p>
        <p class="masthead__meta">IMAGE-MAKING ARCHIVE<br />VOL. 01 / FOUR RECORDS</p>
        <span class="masthead__trace" aria-hidden="true"></span>
      </header>

      <section class="works" aria-label="生图记录">
        {works.map((work, index) => (
          <article
            id={work.id}
            class={`work work--${work.layout}`}
            style={`--accent:${work.accent}`}
            data-index={`${work.index} / 04`}
            data-work={work.id}
            data-accent={work.accent}
          >
            <figure class="work__visual reveal">
              <img
                src={work.image}
                alt={work.alt}
                width="971"
                height="1619"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>

            <div class="work__notes reveal">
              <p class="work__eyebrow">
                <span>{work.archiveTitle}</span>
                <span>{work.year}</span>
              </p>
              <h2>{work.title}</h2>
              <p class="work__artist">{work.artist}</p>

              <span class="work__reading-label">AI reading</span>
              <p class="work__reading">{work.reading}</p>

              <p class="work__request">
                <span class="work__request-label">Input fragment</span>
                {work.request}
              </p>

              <details class="prompt">
                <summary>展开生成 Prompt</summary>
                <div class="prompt__body">
                  <p class="prompt__status">{work.promptStatus}</p>
                  <p class="prompt__recipe">RECIPE — {work.recipe}</p>
                  <pre>{work.prompt}</pre>
                </div>
              </details>
            </div>
          </article>
        ))}
      </section>

      <footer class="site-footer">
        <p>
          Prompt 依据原始会话记录整理。截图中被截断的部分，以当时保存的生成配方补全；
          图片与解读保留为作品档案，不作为事实说明。
        </p>
      </footer>
    </main>

    <script is:inline>
      const navItems = [...document.querySelectorAll('[data-nav]')];
      const works = [...document.querySelectorAll('[data-work]')];
      const reveals = [...document.querySelectorAll('.reveal')];

      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      reveals.forEach((item) => revealObserver.observe(item));

      const workObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;

          const id = visible.target.dataset.work;
          const accent = visible.target.dataset.accent;
          document.documentElement.style.setProperty('--current-accent', accent);
          navItems.forEach((item) => {
            if (item.dataset.nav === id) item.setAttribute('aria-current', 'true');
            else item.removeAttribute('aria-current');
          });
        },
        { rootMargin: '-28% 0px -52% 0px', threshold: [0, 0.2, 0.5] },
      );
      works.forEach((item) => workObserver.observe(item));
    </script>
  </body>
</html>
