---
import { archiveItems, archiveStats } from '../content/archive';
import '../styles/global.css';
import '../styles/home.css';

const randomFallback = archiveItems[0];
const randomIndex = archiveItems.map((item) => ({
  id: item.id,
  defaultVariantId: item.variants[0].id,
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="余像札记：AI 如何理解一首歌、一部电影或一本书，并把这种理解转译成不同视觉风格的海报。"
    />
    <meta name="theme-color" content="#d8d2c6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>余像札记｜AI 文化海报档案</title>
  </head>
  <body class="home-page">
    <div class="page-wash" data-page-wash aria-hidden="true"></div>
    <main class="home-shell">
      <header class="home-cover" aria-labelledby="site-title">
        <h1 id="site-title" class="home-cover__title" data-home-reveal>
          <span>余像札记</span>
          <span>Afterimage Notes</span>
        </h1>

        <p class="home-cover__issue" data-home-reveal>
          CULTURAL POSTER ARCHIVE<br />
          {String(archiveStats.items).padStart(2, '0')} WORKS / {String(archiveStats.posters).padStart(2, '0')} POSTERS / {String(archiveStats.styles).padStart(2, '0')} SYSTEMS
        </p>

        <div class="home-cover__statement" data-home-reveal>
          <p>同一个作品，<br />可以留下不止一种余像。</p>
          <span>AI 对歌曲、电影与书籍的视觉理解。</span>
        </div>

        <nav class="home-cover__choices" aria-label="选择浏览方式" data-home-reveal>
          <a
            href={`/works/${randomFallback.id}/?poster=${randomFallback.variants[0].id}`}
            data-random-work
          >
            <span class="home-choice__no">01</span>
            <span class="home-choice__label">随机来个作品</span>
            <span class="home-choice__note">让档案替你选择</span>
            <span class="home-choice__arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/archive/">
            <span class="home-choice__no">02</span>
            <span class="home-choice__label">进入全部列表</span>
            <span class="home-choice__note">检索、筛选与浏览全部馆藏</span>
            <span class="home-choice__arrow" aria-hidden="true">→</span>
          </a>
        </nav>

        <p class="home-cover__footnote" data-home-reveal>
          NOT A SUMMARY. NOT A RECONSTRUCTION.<br />
          A VISUAL RELATION LEFT AFTER READING.
        </p>
      </header>
    </main>

    <script
      is:inline
      id="random-work-data"
      type="application/json"
      set:html={JSON.stringify(randomIndex)}
    ></script>
    <script src="../scripts/home.ts"></script>
  </body>
</html>
