---
import AssetRecovery from '../../components/AssetRecovery.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import TypographyFonts from '../../components/TypographyFonts.astro';
import {
  archiveItems,
  mediaLabels,
  styleSystems,
} from '../../content/archive';
import '../../styles/global.css';

const PAGE_SIZE = 12;
const firstItem = archiveItems[0];
const firstVariant = firstItem.variants[0];
const firstStyle = styleSystems.find((style) => style.id === firstVariant.styleId)!;
const decades = [...new Set(archiveItems.map((item) => `${Math.floor(Number(item.year) / 10) * 10}`))]
  .sort((a, b) => Number(b) - Number(a));
const archiveIndex = archiveItems.map((item) => ({
  id: item.id,
  archiveNo: item.archiveNo,
  type: item.type,
  typeLabel: mediaLabels[item.type],
  title: item.title,
  originalTitle: item.originalTitle ?? '',
  creator: item.creator,
  year: item.year,
  context: item.context,
  styles: item.variants.map((variant) => variant.styleId),
  defaultVariantId: item.variants[0].id,
  accent: item.variants[0].accent,
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <AssetRecovery />
    <TypographyFonts />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="余像札记作品图录：检索、筛选并浏览 AI 对歌曲、电影与书籍的视觉理解。"
    />
    <meta name="theme-color" content="#d8d2c6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>作品图录｜余像札记</title>
  </head>
  <body class="catalog-page">
    <SiteHeader actionHref="/" actionLabel="返回首页" />
    <main class="archive-shell archive-shell--catalog">
      <section id="catalog" class="archive archive--standalone" aria-labelledby="archive-heading" data-archive-section>
        <header class="archive__header">
          <h1 id="archive-heading">作品图录</h1>
          <p class="sr-only" aria-live="polite"><span data-result-count>{archiveItems.length}</span> 件作品</p>
        </header>

        <details class="catalog-tools" data-catalog-tools>
          <summary>
            <span>
              <small>SEARCH &amp; ARRANGE</small>
              <b>查找与编排</b>
            </span>
            <span class="catalog-tools__state" data-tools-state>全部馆藏</span>
            <i aria-hidden="true"></i>
          </summary>

          <form class="catalog-console" data-catalog-form role="search" aria-label="检索与筛选作品图录">
            <label class="catalog-search">
              <span>检索</span>
              <input
                type="search"
                name="q"
                data-search
                placeholder="题名 / 创作者"
                autocomplete="off"
                enterkeyhint="search"
              />
              <button type="button" data-clear-search aria-label="清除检索" hidden>清除</button>
            </label>

            <div class="catalog-filters">
              <div class="filter-line" role="group" aria-label="按内容类型筛选">
                <span class="filter-line__label">媒介</span>
                <button type="button" data-filter-type="all" aria-pressed="true">全部</button>
                {Object.entries(mediaLabels).map(([id, label]) => (
                  <button type="button" data-filter-type={id} aria-pressed="false">{label}</button>
                ))}
              </div>
              <div class="filter-line" role="group" aria-label="按视觉风格筛选">
                <span class="filter-line__label">视觉</span>
                <button type="button" data-filter-style="all" aria-pressed="true">全部</button>
                {styleSystems.map((style) => (
                  <button type="button" data-filter-style={style.id} aria-pressed="false">{style.label}</button>
                ))}
              </div>
              <div class="filter-line" role="group" aria-label="按年代筛选">
                <span class="filter-line__label">年代</span>
                <button type="button" data-filter-decade="all" aria-pressed="true">全部</button>
                {decades.map((decade) => (
                  <button type="button" data-filter-decade={decade} aria-pressed="false">{decade}s</button>
                ))}
              </div>
              <label class="catalog-sort">
                <span>编排</span>
                <select name="sort" data-sort aria-label="作品排序">
                  <option value="archive">馆藏顺序</option>
                  <option value="newest">年代从新到旧</option>
                  <option value="oldest">年代从旧到新</option>
                  <option value="title">题名顺序</option>
                </select>
              </label>
            </div>
          </form>
        </details>

        <div class="catalog-layout">
          <article
            class="viewer"
            data-viewer
            aria-live="polite"
            aria-busy="true"
            style={`--accent:${firstVariant.accent}`}
          >
            <div class="viewer__frame" data-viewer-frame data-media-state="loading">
              <img
                data-viewer-image
                src={firstVariant.image}
                alt={firstVariant.alt}
                width={firstVariant.width}
                height={firstVariant.height}
                decoding="async"
                fetchpriority="high"
              />
              <img data-viewer-image-next alt="" aria-hidden="true" decoding="async" />
              <div class="media-status" data-media-status aria-live="polite">
                <span class="media-status__mark" aria-hidden="true"></span>
                <span data-media-status-text>正在显影</span>
                <button type="button" data-retry-image hidden>重新显影</button>
              </div>
            </div>

            <section class="catalog-volume" aria-labelledby="volume-title">
              <header class="catalog-volume__header">
                <h2 id="volume-title">选择作品</h2>
              </header>

              <nav class="work-index" aria-label="当前图录分册">
                <ol data-work-index>
                  {archiveIndex.slice(0, PAGE_SIZE).map((item, itemIndex) => (
                    <li>
                      <button
                        type="button"
                        class="index-entry"
                        data-select-work={item.id}
                        aria-current={itemIndex === 0 ? 'true' : undefined}
                        style={`--entry-accent:${item.accent}`}
                      >
                        <span class="index-entry__no">{item.archiveNo}</span>
                        <span class="index-entry__title">{item.title}</span>
                        <span class="index-entry__meta">{item.typeLabel} · {item.year}</span>
                      </button>
                    </li>
                  ))}
                </ol>
                <div class="empty-note" data-empty hidden>
                  <p>这一组条件下没有作品。</p>
                  <button type="button" data-reset-filters>清除条件，回到全部馆藏</button>
                </div>
              </nav>

              <p class="catalog-volume__hint">
                <span>掠过或聚焦档案签，即时预览</span>
                <span>选择作品后，可继续查看海报预览</span>
              </p>

              <button class="catalog-volume__preview" type="button" data-view-selected>
                <span>
                  <small>Selected work</small>
                  <b data-selected-work-title>{firstItem.title}</b>
                </span>
                <span>查看海报预览 <i aria-hidden="true">↓</i></span>
              </button>

              <nav class="catalog-pagination" data-pagination aria-label="作品分页" hidden={archiveItems.length <= PAGE_SIZE}>
                <button type="button" data-page-previous aria-label="上一页"><span aria-hidden="true">←</span><span>上一页</span></button>
                <div data-page-window aria-label="选择作品页"></div>
                <button type="button" data-page-next aria-label="下一页"><span>下一页</span><span aria-hidden="true">→</span></button>
              </nav>
            </section>

            <div class="viewer__notes" data-viewer-notes>
              <p class="viewer__eyebrow">
                <span data-viewer-type>{mediaLabels[firstItem.type]}</span>
                <span><span data-viewer-year>{firstItem.year}</span> / <span data-viewer-context>{firstItem.context}</span></span>
              </p>
              <h2 data-viewer-title>{firstItem.title}</h2>
              <p class="viewer__original" data-viewer-original hidden></p>
              <p class="viewer__creator" data-viewer-creator>{firstItem.creator}</p>

              <div class="variant-nav" data-variant-nav aria-label="海报风格版本"></div>

              <div class="viewer__reading">
                <span>AI interpretation</span>
                <p data-viewer-interpretation>{firstVariant.interpretation}</p>
              </div>

              <p class="viewer__style-note" data-viewer-style-note>{firstStyle.shortDescription}</p>

              <a
                class="viewer__open"
                data-viewer-open
                href={`/works/${firstItem.id}/?poster=${firstVariant.id}`}
              >
                <span>展开这件作品</span><span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        </div>
      </section>

    </main>

    <script
      is:inline
      id="archive-index-data"
      type="application/json"
      set:html={JSON.stringify({
        items: archiveIndex,
        styles: styleSystems,
        pageSize: PAGE_SIZE,
        initialItem: firstItem,
      })}
    ></script>
    <script src="../../scripts/archive-catalog.ts"></script>
  </body>
</html>
